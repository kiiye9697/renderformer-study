# Default deny: only reviewed public families are eligible.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/PUBLIC_FILES.md
!/research/
/research/*
!/research/RenderFormer-精读记录.md
!/report/
/report/*
!/report/*.md
!/report/*.py
!/report/*.docx
!/report/*.pdf
!/scripts/
/scripts/*
!/scripts/*.py
!/unity-exporter/
!/docs/
!/public-data/
# Always local-only, even inside an allowed family.
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/Library/
**/Temp/
**/Logs/
**/UserSettings/
**/obj/
**/*.fbx
**/*.FBX
**/*.obj
**/*.h5
**/*.hdf5
**/*.exr
**/*.blend
**/*.blend1
**/*.npz
**/*.safetensors
**/*.pt
**/*.pth
**/*.log
**/.DS_Store
# Explicit privacy and report build exclusions
/report/private/
/report/.deps/
/report/template-check.md
/report/*工作稿*.pdf
/report/*工作稿*.docx
/report/*预览*.pdf
/report/*预览*.docx
!/report/formulas/
!/report/equations.json
!/report/equations/
!/scripts/*.ps1
# Final report allowlist: one-off QA scripts remain local.
/report/*
!/report/RenderFormer-期末报告.pdf
!/report/RenderFormer-期末报告.docx
!/report/report-draft.md
!/report/build_equations.py
!/report/build_pdf.py
!/report/build_report.py
!/report/build_report_figures.py
!/report/equations.json
!/report/equations/
!/report/figures/
!/report/result-table.json
!/research/input-output-training.md
!/research/training-results.md
!/scripts/training/
/scripts/training/*
!/scripts/training/*.py
!/scripts/training/*.md
